     8	/**
     9	 * The explicit boundary operation that creates the problematic transaction.
    10	 *
    11	 * <p>Do not replace this with a prebuilt transaction log. ZOOKEEPER-1513 is
    12	 * reproduced only when ZooKeeper itself accepts an ordinary client write and
    13	 * persists the transaction that it later cannot replay.</p>
    14	 */
    15	public final class FaultInjection {
    16	    public static final String DEFAULT_ZNODE = "/zookeeper-1513";
    17	    public static final int EXPECTED_TRANSACTION_SIZE = 1_048_583;
    18	
    19	    // ZooKeeper 3.3.4's binary transaction consists of a 32-byte TxnHeader,
    20	    // then the SetDataTxn path (4-byte length + UTF-8 bytes), data (4-byte
    21	    // length + bytes), and version (4 bytes).
    22	    private static final int TXN_HEADER_SIZE = 32;
    23	    private static final int SET_DATA_FIXED_SIZE = 12;
    24	
    25	    private FaultInjection() {
    26	    }
    27	
    28	    /**
    29	     * Build deterministic data whose persisted transaction is exactly the
    30	     * 1,048,583-byte record reported by ZOOKEEPER-1513. The data itself stays
    31	     * below 3.3.4's 0xfffff readBuffer limit, so the live request is accepted.
    32	     */
    33	    public static byte[] deterministicPayload(String path) {
    34	        byte[] payload = new byte[expectedPayloadSize(path)];
    35	        for (int i = 0; i < payload.length; i++) {
    36	            payload[i] = (byte) ((i * 31 + 17) & 0xff);
    37	        }
    38	        return payload;
    39	    }
    40	
    41	    public static int expectedPayloadSize(String path) {
    42	        int pathBytes = path.getBytes(StandardCharsets.UTF_8).length;
    43	        int payloadSize = EXPECTED_TRANSACTION_SIZE - TXN_HEADER_SIZE
    44	                - SET_DATA_FIXED_SIZE - pathBytes;
    45	        if (payloadSize < 0) {
    46	            throw new IllegalArgumentException("znode path is too long: " + path);
    47	        }
    48	        return payloadSize;
    49	    }
    50	
    51	    /**
    52	     * Submit the boundary-sized setData request and return only after the
    53	     * server acknowledges it.
    54	     */
    55	    public static Stat inject(ZooKeeper client, String path, byte[] payload)
    56	            throws Exception {
    57	        int expectedSize = expectedPayloadSize(path);
    58	        if (payload.length != expectedSize) {
    59	            throw new IllegalArgumentException(
    60	                    "Fault payload must be exactly " + expectedSize
    61	                            + " bytes, but was " + payload.length);
    62	        }
    63	        return client.setData(path, payload, -1);
    64	    }
    65	
    66	    public static String sha256(byte[] payload) {
    67	        try {
    68	            MessageDigest digest = MessageDigest.getInstance("SHA-256");
    69	            byte[] hash = digest.digest(payload);
    70	            StringBuilder value = new StringBuilder(hash.length * 2);
    71	            for (byte octet : hash) {
    72	                value.append(String.format("%02x", octet & 0xff));
    73	            }
    74	            return value.toString();
    75	        } catch (NoSuchAlgorithmException impossible) {
    76	            throw new IllegalStateException("SHA-256 is unavailable", impossible);
    77	        }
    78	    }
    79	}
     1	import java.io.BufferedWriter;
     2	import java.io.IOException;
