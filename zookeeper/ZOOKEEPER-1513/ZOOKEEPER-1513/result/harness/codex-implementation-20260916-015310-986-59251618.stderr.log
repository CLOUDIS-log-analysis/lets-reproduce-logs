    10	import java.util.concurrent.CountDownLatch;
    11	import java.util.concurrent.TimeUnit;
    12	
    13	import org.apache.zookeeper.CreateMode;
    14	import org.apache.zookeeper.KeeperException;
    15	import org.apache.zookeeper.WatchedEvent;
    16	import org.apache.zookeeper.Watcher;
    17	import org.apache.zookeeper.ZooDefs;
    18	import org.apache.zookeeper.ZooKeeper;
    19	import org.apache.zookeeper.data.Stat;
    20	
    21	/**
    22	 * Creates the normal client transaction needed to reproduce ZOOKEEPER-1513.
    23	 * Server stop/restart is intentionally controlled outside this process so the
    24	 * same persistent bind mount can be retained for replay.
    25	 */
    26	public final class Reproduce {
    27	    private static final int SESSION_TIMEOUT_MS = 10_000;
    28	    private static final int CONNECT_TIMEOUT_SECONDS = 20;
    29	    private static final byte[] INITIAL_DATA =
    30	            "initial".getBytes(StandardCharsets.UTF_8);
    31	
    32	    private Reproduce() {
    33	    }
    34	
    35	    public static void main(String[] args) {
    36	        if (args.length < 2 || args.length > 3) {
    37	            usage();
    38	            System.exit(2);
    39	        }
    40	
    41	        String connectString = args[0];
    42	        Path evidenceFile = Paths.get(args[1]);
    43	        String znode = args.length == 3 ? args[2] : FaultInjection.DEFAULT_ZNODE;
    44	
    45	        try {
    46	            reproduce(connectString, znode, evidenceFile);
    47	        } catch (Exception failure) {
    48	            System.err.println("Reproduction write failed: " + failure);
    49	            failure.printStackTrace(System.err);
    50	            System.exit(1);
    51	        }
    52	    }
    53	
    54	    static void reproduce(String connectString, String znode, Path evidenceFile)
    55	            throws Exception {
    56	        validateZnode(znode);
    57	        refuseExistingEvidence(evidenceFile);
    58	
    59	        final CountDownLatch connected = new CountDownLatch(1);
    60	        ZooKeeper client = new ZooKeeper(connectString, SESSION_TIMEOUT_MS,
    61	                new Watcher() {
    62	                    @Override
    63	                    public void process(WatchedEvent event) {
    64	                        if (event.getState() == Event.KeeperState.SyncConnected) {
    65	                            connected.countDown();
    66	                        }
    67	                    }
    68	                });
    69	
    70	        try {
    71	            if (!connected.await(CONNECT_TIMEOUT_SECONDS, TimeUnit.SECONDS)) {
    72	                throw new IOException("Timed out connecting to " + connectString);
    73	            }
    74	
    75	            try {
    76	                client.create(znode, INITIAL_DATA, ZooDefs.Ids.OPEN_ACL_UNSAFE,
    77	                        CreateMode.PERSISTENT);
    78	            } catch (KeeperException.NodeExistsException exists) {
    79	                throw new IllegalStateException(
    80	                        "The reproduction znode already exists; use a clean attempt: "
    81	                                + znode,
    82	                        exists);
    83	            }
    84	
    85	            byte[] payload = FaultInjection.deterministicPayload(znode);
    86	            Stat acknowledged = FaultInjection.inject(client, znode, payload);
    87	
    88	            Map<String, String> evidence = new LinkedHashMap<String, String>();
    89	            evidence.put("write.acknowledged", "true");
    90	            evidence.put("write.path", znode);
    91	            evidence.put("write.payload.bytes", Integer.toString(payload.length));
    92	            evidence.put("write.payload.sha256", FaultInjection.sha256(payload));
    93	            evidence.put("write.transaction.bytes", Integer.toString(
    94	                    FaultInjection.EXPECTED_TRANSACTION_SIZE));
    95	            evidence.put("write.version", Integer.toString(acknowledged.getVersion()));
    96	            evidence.put("write.mzxid", Long.toString(acknowledged.getMzxid()));
    97	            writeEvidenceCreateOnly(evidenceFile, evidence);
    98	
    99	            System.out.println("ACKNOWLEDGED path=" + znode
   100	                    + " bytes=" + payload.length
   101	                    + " version=" + acknowledged.getVersion()
   102	                    + " mzxid=" + acknowledged.getMzxid());
   103	            System.out.println("Evidence: " + evidenceFile.toAbsolutePath());
   104	        } finally {
   105	            client.close();
   106	        }
   107	    }
   108	
   109	    private static void validateZnode(String znode) {
   110	        if (!znode.startsWith("/") || "/".equals(znode)
   111	                || znode.endsWith("/")) {
   112	            throw new IllegalArgumentException(
   113	                    "znode must be an absolute non-root path: " + znode);
   114	        }
   115	    }
   116	
   117	    private static void refuseExistingEvidence(Path evidenceFile)
   118	            throws IOException {
   119	        if (Files.exists(evidenceFile)) {
   120	            throw new IOException("Refusing to overwrite evidence: " + evidenceFile);
   121	        }
   122	    }
   123	
   124	    private static void writeEvidenceCreateOnly(Path evidenceFile,
   125	            Map<String, String> evidence) throws IOException {
   126	        Path absolute = evidenceFile.toAbsolutePath();
   127	        Path parent = absolute.getParent();
   128	        if (parent != null && !Files.isDirectory(parent)) {
   129	            throw new IOException("Evidence directory does not exist: " + parent);
   130	        }
   131	
   132	        BufferedWriter writer = Files.newBufferedWriter(absolute,
   133	                StandardCharsets.UTF_8, StandardOpenOption.CREATE_NEW,
   134	                StandardOpenOption.WRITE);
   135	        try {
   136	            for (Map.Entry<String, String> entry : evidence.entrySet()) {
   137	                writer.write(entry.getKey());
   138	                writer.write('=');
   139	                writer.write(entry.getValue());
   140	                writer.newLine();
   141	            }
   142	        } finally {
   143	            writer.close();
   144	        }
   145	    }
   146	
   147	    private static void usage() {
   148	        System.err.println("Usage: java -jar zookeeper-1513-reproducer.jar "
   149	                + "<connect-string> <new-evidence.properties> [znode]");
   150	    }
   151	}
     1	import java.io.BufferedReader;
     2	import java.io.IOException;
     3	import java.nio.charset.StandardCharsets;
     4	import java.nio.file.Files;
     5	import java.nio.file.Path;
     6	import java.nio.file.Paths;
     7	import java.util.LinkedHashMap;
     8	import java.util.Map;
     9	
    10	/** Evaluates the explicit ZOOKEEPER-1513 result oracle. */
    11	public final class Verify {
    12	    private static final String EXPECTED_LENGTH =
    13	            "Unreasonable length = 1048583";
    14	    private static final String[] REPLAY_FRAMES = {
    15	        "BinaryInputArchive.readBuffer",
    16	        "Util.readTxnBytes",
    17	        "FileTxnLog",
    18	        "ZKDatabase.loadDataBase"
    19	    };
    20	
    21	    private Verify() {
    22	    }
    23	
    24	    public static void main(String[] args) {
    25	        if (args.length != 3) {
    26	            usage();
    27	            System.exit(2);
    28	        }
    29	
    30	        try {
    31	            int restartExitCode = Integer.parseInt(args[2]);
    32	            boolean reproduced = verify(Paths.get(args[0]), Paths.get(args[1]),
    33	                    restartExitCode);
    34	            System.exit(reproduced ? 0 : 1);
    35	        } catch (Exception failure) {
    36	            System.err.println("Verification error: " + failure);
    37	            System.exit(2);
    38	        }
    39	    }
    40	
    41	    static boolean verify(Path writeEvidence, Path restartOutput,
    42	            int restartExitCode) throws IOException {
    43	        Map<String, String> evidence = readSimpleProperties(writeEvidence);
    44	        String output = new String(Files.readAllBytes(restartOutput),
    45	                StandardCharsets.UTF_8);
    46	
    47	        String path = evidence.get("write.path");
    48	        boolean pathPresent = path != null;
    49	        byte[] expectedPayload = pathPresent
    50	                ? FaultInjection.deterministicPayload(path) : new byte[0];
    51	        boolean writeAcknowledged = "true".equals(
    52	                evidence.get("write.acknowledged"));
    53	        boolean payloadSizeMatches = pathPresent
    54	                && Integer.toString(expectedPayload.length)
    55	                .equals(evidence.get("write.payload.bytes"));
    56	        boolean payloadDigestMatches = pathPresent
    57	                && FaultInjection.sha256(expectedPayload)
    58	                .equals(evidence.get("write.payload.sha256"));
    59	        boolean transactionSizeMatches = Integer.toString(
    60	                FaultInjection.EXPECTED_TRANSACTION_SIZE)
    61	                .equals(evidence.get("write.transaction.bytes"));
    62	        boolean restartFailed = restartExitCode != 0;
    63	        boolean exactLengthSeen = output.contains(EXPECTED_LENGTH);
    64	        boolean replayPathSeen = true;
    65	        for (String frame : REPLAY_FRAMES) {
    66	            replayPathSeen &= output.contains(frame);
    67	        }
    68	
    69	        boolean reproduced = writeAcknowledged && payloadSizeMatches
    70	                && payloadDigestMatches && transactionSizeMatches
    71	                && restartFailed && exactLengthSeen && replayPathSeen;
    72	
    73	        System.out.println("write.acknowledged=" + writeAcknowledged);
    74	        System.out.println("write.payload.size.matches=" + payloadSizeMatches);
    75	        System.out.println("write.payload.digest.matches=" + payloadDigestMatches);
    76	        System.out.println("write.transaction.size.matches="
    77	                + transactionSizeMatches);
    78	        System.out.println("restart.failed=" + restartFailed);
    79	        System.out.println("restart.exact.length.seen=" + exactLengthSeen);
    80	        System.out.println("restart.replay.path.seen=" + replayPathSeen);
    81	        System.out.println("reproduced=" + reproduced);
    82	        return reproduced;
    83	    }
    84	
    85	    private static Map<String, String> readSimpleProperties(Path file)
    86	            throws IOException {
    87	        Map<String, String> values = new LinkedHashMap<String, String>();
    88	        BufferedReader reader = Files.newBufferedReader(file,
    89	                StandardCharsets.UTF_8);
    90	        try {
    91	            String line;
    92	            while ((line = reader.readLine()) != null) {
    93	                if (line.isEmpty() || line.startsWith("#")) {
    94	                    continue;
    95	                }
    96	                int separator = line.indexOf('=');
    97	                if (separator <= 0) {
    98	                    throw new IOException("Malformed evidence line: " + line);
    99	                }
   100	                values.put(line.substring(0, separator),
   101	                        line.substring(separator + 1));
   102	            }
   103	        } finally {
   104	            reader.close();
   105	        }
   106	        return values;
   107	    }
   108	
   109	    private static void usage() {
   110	        System.err.println("Usage: java -cp zookeeper-1513-reproducer.jar Verify "
   111	                + "<write-evidence.properties> <restart-output.log> "
   112	                + "<restart-exit-code>");
   113	    }
   114	}
