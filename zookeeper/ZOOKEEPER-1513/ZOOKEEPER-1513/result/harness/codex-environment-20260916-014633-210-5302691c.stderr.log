@@ -0,0 +1,39 @@
+FROM eclipse-temurin:8-jre-jammy
+
+ARG ZK_UID=1000
+ARG ZK_GID=988
+
+RUN groupadd --gid "${ZK_GID}" zookeeper \
+    && useradd --uid "${ZK_UID}" --gid "${ZK_GID}" \
+        --home-dir /var/lib/zookeeper --no-create-home \
+        --shell /usr/sbin/nologin zookeeper
+
+COPY dist/zookeeper-3.3.4.tar.gz /tmp/zookeeper-3.3.4.tar.gz
+
+RUN echo "cbb259eac2ae5c10956c49db5b2a05e112d645ac  /tmp/zookeeper-3.3.4.tar.gz" \
+        | sha1sum -c - \
+    && tar -xzf /tmp/zookeeper-3.3.4.tar.gz -C /opt \
+    && ln -s /opt/zookeeper-3.3.4 /opt/zookeeper \
+    && rm /tmp/zookeeper-3.3.4.tar.gz \
+    && mkdir -p /etc/zookeeper /var/lib/zookeeper /var/log/zookeeper /result \
+    && chown "${ZK_UID}:${ZK_GID}" \
+        /var/lib/zookeeper /var/log/zookeeper /result
+
+COPY zoo.cfg log4j.properties /etc/zookeeper/
+COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
+
+RUN chmod 0555 /usr/local/bin/docker-entrypoint.sh \
+    && chmod 0444 /etc/zookeeper/zoo.cfg /etc/zookeeper/log4j.properties
+
+ENV ZOOCFGDIR=/etc/zookeeper \
+    ZOO_LOG_DIR=/var/log/zookeeper \
+    ZOO_LOG4J_PROP=INFO,CONSOLE,ROLLINGFILE \
+    SERVER_JVMFLAGS="-Xms256m -Xmx512m"
+
+WORKDIR /opt/zookeeper
+USER ${ZK_UID}:${ZK_GID}
+
+EXPOSE 2181
+
+ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
+CMD ["/opt/zookeeper/bin/zkServer.sh", "start-foreground", "/etc/zookeeper/zoo.cfg"]
diff --git a/compose.yml b/compose.yml
new file mode 100644
index 0000000000000000000000000000000000000000..56edd320de2fe38e46188d47c3c285bf0d1a3cc2
--- /dev/null
+++ b/compose.yml
@@ -0,0 +1,33 @@
+services:
+  zookeeper:
+    build:
+      context: .
+      args:
+        ZK_UID: "${ZK_UID:-1000}"
+        ZK_GID: "${ZK_GID:-988}"
+    image: zookeeper-1513:3.3.4-jdk8
+    user: "${ZK_UID:-1000}:${ZK_GID:-988}"
+    read_only: true
+    init: true
+    cap_drop:
+      - ALL
+    security_opt:
+      - no-new-privileges:true
+    ports:
+      - "127.0.0.1:${ZK_CLIENT_PORT:-2181}:2181"
+    volumes:
+      - type: bind
+        source: ${ZK_DATA_DIR:-./data}
+        target: /var/lib/zookeeper
+      - type: bind
+        source: ${ZK_LOG_DIR:-./logs}
+        target: /var/log/zookeeper
+      - type: bind
+        source: ${ZK_RESULT_DIR:-./result}
+        target: /result
+        read_only: true
+    tmpfs:
+      - /tmp:rw,noexec,nosuid,size=16m,mode=1777
+    stop_grace_period: 20s
+    cpus: 2.0
+    mem_limit: 2g
diff --git a/docker-entrypoint.sh b/docker-entrypoint.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3e3b53052c1a1d9160214c2ae37e8d93fe84f6a5
--- /dev/null
+++ b/docker-entrypoint.sh
@@ -0,0 +1,23 @@
+#!/bin/sh
+set -eu
+
+# Files created in bind mounts must remain readable and directories traversable
+# by the host-side Harness account.
+umask 022
+
+for writable_dir in /var/lib/zookeeper /var/log/zookeeper; do
+    if [ ! -d "${writable_dir}" ]; then
+        mkdir -p "${writable_dir}"
+    fi
+    if [ ! -r "${writable_dir}" ] || [ ! -w "${writable_dir}" ] || [ ! -x "${writable_dir}" ]; then
+        echo "ZooKeeper requires a readable, writable, traversable mount: ${writable_dir}" >&2
+        exit 73
+    fi
+done
+
+if [ -d /result ] && { [ ! -r /result ] || [ ! -x /result ]; }; then
+    echo "The result mount must be readable and traversable: /result" >&2
+    exit 73
+fi
+
+exec "$@"
diff --git a/log4j.properties b/log4j.properties
new file mode 100644
index 0000000000000000000000000000000000000000..4e0cd74ee2fa3902cb1dd7943a929387397d56bc
--- /dev/null
+++ b/log4j.properties
@@ -0,0 +1,17 @@
+# ZooKeeper 3.3.4 uses Log4j 1.2. Keep startup/replay evidence both on
+# container stdout and in the host-mounted log directory.
+log4j.rootLogger=${zookeeper.root.logger}
+
+log4j.appender.CONSOLE=org.apache.log4j.ConsoleAppender
+log4j.appender.CONSOLE.Threshold=INFO
+log4j.appender.CONSOLE.Target=System.err
+log4j.appender.CONSOLE.layout=org.apache.log4j.PatternLayout
+log4j.appender.CONSOLE.layout.ConversionPattern=%d{ISO8601} - %-5p [%t:%C{1}@%L] - %m%n
+
+log4j.appender.ROLLINGFILE=org.apache.log4j.RollingFileAppender
+log4j.appender.ROLLINGFILE.Threshold=INFO
+log4j.appender.ROLLINGFILE.File=${zookeeper.log.dir}/zookeeper.log
+log4j.appender.ROLLINGFILE.MaxFileSize=10MB
+log4j.appender.ROLLINGFILE.MaxBackupIndex=10
+log4j.appender.ROLLINGFILE.layout=org.apache.log4j.PatternLayout
+log4j.appender.ROLLINGFILE.layout.ConversionPattern=%d{ISO8601} - %-5p [%t:%C{1}@%L] - %m%n
