exec
/bin/bash -lc 'set -euo pipefail
smoke_data=data/environment-smoke
smoke_logs=logs/environment-smoke
if [ -e "$smoke_data" ] || [ -e "$smoke_logs" ]; then
  echo '"'refusing to reuse an existing environment smoke directory' >&2
  exit 1
fi
mkdir \""'$smoke_data" "$smoke_logs"
chmod 2775 "$smoke_data" "$smoke_logs"
export ZK_DATA_DIR="./$smoke_data"
export ZK_LOG_DIR="./$smoke_logs"
export ZK_CLIENT_PORT=22181
cleanup() {
  docker compose -f compose.yml down --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker compose -f compose.yml up -d --no-build
ready=0
for try in $(seq 1 30); do
  if docker compose -f compose.yml exec -T zookeeper bash -c '"'exec 3<>/dev/tcp/127.0.0.1/2181; printf ruok >&3; IFS= read -r -n 4 -t 1 reply <&3; test \""'$reply" = imok'"' 2>/dev/null; then
    ready=1
    echo \"readiness=imok attempt="'$try"
    break
  fi
  sleep 1
done
if [ "$ready" -ne 1 ]; then
  docker compose -f compose.yml logs --no-color
  exit 1
fi

docker compose -f compose.yml exec -T zookeeper sh -c '"'id; printf \"umask=\"; umask; test -w /var/lib/zookeeper; test -w /var/log/zookeeper; test -r /result; test "'! -w /result; echo mount-check=OK'"'
docker compose -f compose.yml logs --no-color

docker compose -f compose.yml stop
trap - EXIT
docker compose -f compose.yml down --remove-orphans

find \""'$smoke_data" "$smoke_logs" -printf '"'%m %u:%g %p\\n' | sort
find \""'$smoke_logs" -type f -exec chmod 0444 {} +
find "$smoke_logs" -type d -exec chmod 0555 {} +
echo protected-smoke-log=OK
find "$smoke_logs" -printf '"'%m %u:%g %p\\n' | sort
find result -maxdepth 2 -printf '%m %u:%g %p\\n' | sort" in /home/shkim/mydir/zk-collect/issues/ZOOKEEPER-1513
