(cd dist && sha1sum -c zookeeper-3.3.4.tar.gz.sha1)
docker compose -f compose.yml config --quiet
docker run --rm --entrypoint /bin/sh zookeeper-1513:3.3.4-jdk8 -c 'java -cp /opt/zookeeper/zookeeper-3.3.4.jar org.apache.zookeeper.Version --full; javac -version; id'
test "'! -w logs/environment-smoke
test ! -w logs/environment-smoke/zookeeper.log
test -r logs/environment-smoke/zookeeper.log
test -x logs/environment-smoke
test "$(docker ps --filter label=com.docker.compose.project=zookeeper-1513 --format '"'{{.ID}}' | wc -l)\" -eq 0
if find . -type f \\( -name Reproduce.java -o -name FaultInjection.java -o -name Verify.java \\) -print -quit | grep -q .; then
  echo 'forbidden later-stage Java source exists' >&2
  exit 1
fi
printf 'final-image=' && docker image inspect zookeeper-1513:3.3.4-jdk8 --format '{{.Id}} user={{.Config.User}}'
printf '%s\\n' 'protected-smoke-artifacts:'
