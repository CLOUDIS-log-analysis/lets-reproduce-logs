docker inspect \""'$container_id" --format '"'container={{.Name}} running={{.State.Running}} status={{.State.Status}} health={{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} restart_count={{.RestartCount}} oom={{.State.OOMKilled}} user={{.Config.User}} started={{.State.StartedAt}}'
