===== compose.yml
name: zookeeper-1560

services:
  zookeeper:
    image: zookeeper-1560:3.4.4-jdk6
    build:
      context: .
      dockerfile: Dockerfile
    platform: linux/amd64
    user: "${HOST_UID:-1000}:${HOST_GID:-1000}"
    init: true
    environment:
      JMXDISABLE: "true"
      ZOO_LOG_DIR: /logs
      ZOO_LOG4J_PROP: INFO,CONSOLE,ROLLINGFILE
      SERVER_JVMFLAGS: -Xms128m -Xmx512m -Djava.io.tmpdir=/data/tmp
    volumes:
      - type: bind
        source: ${ZK_DATA_DIR:-./data}
        target: /data
      - type: bind
        source: ${ZK_LOG_DIR:-./logs}
        target: /logs
      - type: bind
        source: ${ZK_RESULT_DIR:-./result}
        target: /result
    ports:
      - "127.0.0.1:${ZK_CLIENT_PORT:-2181}:2181"
    cpus: 1.0
    mem_limit: 1g
    stop_grace_period: 10s
    healthcheck:
      test: ["CMD-SHELL", "/opt/zookeeper/bin/zkServer.sh status /opt/zookeeper/conf/zoo.cfg >/dev/null 2>&1"]
      interval: 2s
      timeout: 5s
      retries: 15
      start_period: 5s
===== Dockerfile
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

ARG ZK_ARCHIVE=zookeeper-3.4.4.tar.gz
ARG JDK_ARCHIVE=zulu6.22.0.3-ca-jdk6.0.119-linux_x64.tar.gz

COPY dist/${ZK_ARCHIVE} dist/${JDK_ARCHIVE} dist/SHA256SUMS /tmp/dist/

RUN set -eux; \
    cd /tmp/dist; \
    sha256sum -c SHA256SUMS; \
    tar -xzf "${ZK_ARCHIVE}" -C /opt; \
    tar -xzf "${JDK_ARCHIVE}" -C /opt; \
    ln -s /opt/zookeeper-3.4.4 /opt/zookeeper; \
    ln -s /opt/zulu6.22.0.3-jdk6.0.119-linux_x64 /opt/java; \
    groupadd --gid 1000 zookeeper; \
    useradd --uid 1000 --gid 1000 --home-dir /opt/zookeeper --shell /usr/sbin/nologin zookeeper; \
    install -d -o zookeeper -g zookeeper -m 0755 /data /logs /result; \
    rm -rf /tmp/dist

COPY --chmod=0644 config/zoo.cfg config/log4j.properties /opt/zookeeper/conf/
COPY --chmod=0755 scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

ENV JAVA_HOME=/opt/java \
    ZK_HOME=/opt/zookeeper \
    ZOOCFGDIR=/opt/zookeeper/conf \
    ZOO_LOG_DIR=/logs \
    ZOO_LOG4J_PROP=INFO,CONSOLE,ROLLINGFILE \
    JMXDISABLE=true \
    SERVER_JVMFLAGS="-Xms128m -Xmx512m -Djava.io.tmpdir=/data/tmp" \
    PATH=/opt/java/bin:/opt/zookeeper/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /opt/zookeeper
USER 1000:1000
EXPOSE 2181

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["/opt/zookeeper/bin/zkServer.sh", "start-foreground", "/opt/zookeeper/conf/zoo.cfg"]
===== pom.xml
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.apache.zookeeper.reproduction</groupId>
  <artifactId>zookeeper-1560-reproduction</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>ZOOKEEPER-1560 reproduction</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.6</maven.compiler.source>
    <maven.compiler.target>1.6</maven.compiler.target>
    <zookeeper.version>3.4.4</zookeeper.version>
    <jdk6.archive>${project.basedir}/dist/zulu6.22.0.3-ca-jdk6.0.119-linux_x64.tar.gz</jdk6.archive>
    <jdk6.home>${project.build.directory}/toolchain/zulu6.22.0.3-jdk6.0.119-linux_x64</jdk6.home>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.zookeeper</groupId>
      <artifactId>zookeeper</artifactId>
      <version>${zookeeper.version}</version>
      <exclusions>
        <!--
          The release POM's Log4j 1.2.16 graph refers to retired java.net
          artifacts using Maven's unsupported legacy repository layout.
          ZooKeeper logs through SLF4J, so use slf4j-simple below instead.
        -->
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-log4j12</artifactId>
        </exclusion>
        <exclusion>
          <groupId>log4j</groupId>
          <artifactId>log4j</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>1.6.1</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The reproduction image runs JDK 6. Compile with the pinned JDK from
        dist/ rather than silently producing newer class files with the host
        JDK used to launch Maven.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>extract-pinned-jdk6</id>
            <phase>initialize</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/toolchain" />
                <untar src="${jdk6.archive}"
                       dest="${project.build.directory}/toolchain"
                       compression="gzip" />
                <chmod dir="${jdk6.home}/bin" includes="*" perm="755" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <fork>true</fork>
          <executable>${jdk6.home}/bin/javac</executable>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
          <encoding>${project.build.sourceEncoding}</encoding>
          <showWarnings>true</showWarnings>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.apache.zookeeper.Reproduce</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.apache.zookeeper.Reproduce</mainClass>
            </manifest>
          </archive>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
          <finalName>zookeeper-1560-reproduction</finalName>
          <appendAssemblyId>true</appendAssemblyId>
        </configuration>
        <executions>
          <execution>
            <id>make-runnable-jar</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
===== config/zoo.cfg
# Standalone ZooKeeper 3.4.4 configuration for ZOOKEEPER-1560.
tickTime=2000
initLimit=10
syncLimit=5
dataDir=/data
dataLogDir=/data/txnlog
clientPort=2181
maxClientCnxns=60

# Keep automatic cleanup disabled. Each experiment attempt supplies a fresh
# host-side data directory and preserves it for diagnosis.
autopurge.purgeInterval=0
===== config/log4j.properties
# ZooKeeper 3.4.4 uses Log4j 1.x. Values on the first six lines may be
# overridden by the system properties set by the bundled zkServer.sh.
zookeeper.root.logger=INFO, CONSOLE, ROLLINGFILE
zookeeper.console.threshold=INFO
zookeeper.log.dir=/logs
zookeeper.log.file=zookeeper.log
zookeeper.log.threshold=DEBUG
zookeeper.tracelog.dir=/logs
zookeeper.tracelog.file=zookeeper_trace.log

log4j.rootLogger=${zookeeper.root.logger}

log4j.appender.CONSOLE=org.apache.log4j.ConsoleAppender
log4j.appender.CONSOLE.Threshold=${zookeeper.console.threshold}
log4j.appender.CONSOLE.layout=org.apache.log4j.PatternLayout
log4j.appender.CONSOLE.layout.ConversionPattern=%d{ISO8601} [myid:%X{myid}] - %-5p [%t:%C{1}@%L] - %m%n

log4j.appender.ROLLINGFILE=org.apache.log4j.RollingFileAppender
log4j.appender.ROLLINGFILE.Threshold=${zookeeper.log.threshold}
log4j.appender.ROLLINGFILE.File=${zookeeper.log.dir}/${zookeeper.log.file}
log4j.appender.ROLLINGFILE.Append=true
log4j.appender.ROLLINGFILE.MaxFileSize=10MB
log4j.appender.ROLLINGFILE.MaxBackupIndex=10
log4j.appender.ROLLINGFILE.layout=org.apache.log4j.PatternLayout
log4j.appender.ROLLINGFILE.layout.ConversionPattern=%d{ISO8601} [myid:%X{myid}] - %-5p [%t:%C{1}@%L] - %m%n

log4j.appender.TRACEFILE=org.apache.log4j.FileAppender
log4j.appender.TRACEFILE.Threshold=TRACE
log4j.appender.TRACEFILE.File=${zookeeper.tracelog.dir}/${zookeeper.tracelog.file}
log4j.appender.TRACEFILE.Append=true
log4j.appender.TRACEFILE.layout=org.apache.log4j.PatternLayout
log4j.appender.TRACEFILE.layout.ConversionPattern=%d{ISO8601} [myid:%X{myid}] - %-5p [%t:%C{1}@%L][%x] - %m%n
===== scripts/docker-entrypoint.sh
#!/bin/sh
set -eu

# Files and directories created through host bind mounts must remain readable
# and traversable by the host-side Harness account.
umask 022

for mounted_dir in /logs /data /result; do
    if [ ! -d "$mounted_dir" ]; then
        echo "required bind-mount directory is missing: $mounted_dir" >&2
        exit 70
    fi
    if [ ! -r "$mounted_dir" ] || [ ! -w "$mounted_dir" ] || [ ! -x "$mounted_dir" ]; then
        echo "required bind-mount directory is not readable, writable, and traversable: $mounted_dir" >&2
        exit 71
    fi
done

mkdir -p /data/txnlog /data/tmp

exec "$@"
===== scripts/protect-artifacts.sh
#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    echo "usage: $0 logs/attempt-NNN-or-unique-name | result/attempt-NNN.properties | result/attempt-NNN-or-unique-name" >&2
    exit 64
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
issue_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

if [ -L "$1" ]; then
    echo "refusing to protect a symbolic link: $1" >&2
    exit 65
fi

if [ -d "$1" ]; then
    artifact_path=$(CDPATH= cd -- "$1" && pwd -P)
    artifact_kind=directory
elif [ -f "$1" ]; then
    artifact_parent=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd -P)
    artifact_path=$artifact_parent/$(basename -- "$1")
    artifact_kind=file
else
    echo "artifact file or directory does not exist: $1" >&2
    exit 66
fi

case "$artifact_path" in
    "$issue_dir"/logs/*|"$issue_dir"/result/*) ;;
    *)
        echo "refusing to protect a path outside logs/ or result/: $artifact_path" >&2
        exit 65
        ;;
esac

# Regular files become read-only and directories stay readable/traversable,
# including for Harness processes outside the container. Reject symlinks so a
# directory walk can never change permissions outside the selected tree.
if [ "$artifact_kind" = file ]; then
    chmod 0444 "$artifact_path"
else
    if find -P "$artifact_path" -type l -print -quit | grep -q .; then
        echo "refusing to protect an artifact tree containing symbolic links: $artifact_path" >&2
        exit 65
    fi

    find -P "$artifact_path" -type f -exec chmod 0444 {} +
    find -P "$artifact_path" -depth -type d -exec chmod 0555 {} +
fi
