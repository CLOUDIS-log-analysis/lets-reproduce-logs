--- /dev/null
+++ b/config/zoo.cfg
@@ -0,0 +1,12 @@
+# Standalone ZooKeeper 3.4.4 configuration for ZOOKEEPER-1560.
+tickTime=2000
+initLimit=10
+syncLimit=5
+dataDir=/data
+dataLogDir=/data/txnlog
+clientPort=2181
+maxClientCnxns=60
+
+# Keep automatic cleanup disabled. Each experiment attempt supplies a fresh
+# host-side data directory and preserves it for diagnosis.
+autopurge.purgeInterval=0
