--- /dev/null
+++ b/scripts/docker-entrypoint.sh
@@ -0,0 +1,21 @@
+#!/bin/sh
+set -eu
+
+# Files and directories created through host bind mounts must remain readable
+# and traversable by the host-side Harness account.
+umask 022
+
+for mounted_dir in /logs /data /result; do
+    if [ ! -d "$mounted_dir" ]; then
+        echo "required bind-mount directory is missing: $mounted_dir" >&2
+        exit 70
+    fi
+    if [ ! -r "$mounted_dir" ] || [ ! -w "$mounted_dir" ] || [ ! -x "$mounted_dir" ]; then
+        echo "required bind-mount directory is not readable, writable, and traversable: $mounted_dir" >&2
+        exit 71
+    fi
+done
+
+mkdir -p /data/txnlog /data/tmp
+
+exec "$@"
diff --git a/scripts/protect-artifacts.sh b/scripts/protect-artifacts.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c82edf8185bedefa712d438c8051d04b8fa6148a
--- /dev/null
+++ b/scripts/protect-artifacts.sh
@@ -0,0 +1,35 @@
+#!/bin/sh
+set -eu
+
+if [ "$#" -ne 1 ]; then
+    echo "usage: $0 logs/attempt-NNN-or-unique-name | result/attempt-NNN-or-unique-name" >&2
+    exit 64
+fi
+
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+issue_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
+
+if [ ! -d "$1" ]; then
+    echo "artifact directory does not exist: $1" >&2
+    exit 66
+fi
+
+artifact_dir=$(CDPATH= cd -- "$1" && pwd -P)
+case "$artifact_dir" in
+    "$issue_dir"/logs/*|"$issue_dir"/result/*) ;;
+    *)
+        echo "refusing to protect a path outside a per-attempt logs/ or result/ directory: $artifact_dir" >&2
+        exit 65
+        ;;
+esac
+
+# Reject symlinks so this helper can never change permissions outside the
+# selected artifact tree. Regular files become read-only and directories stay
+# readable/traversable, including for Harness processes outside the container.
+if find -P "$artifact_dir" -type l -print -quit | grep -q .; then
+    echo "refusing to protect an artifact tree containing symbolic links: $artifact_dir" >&2
+    exit 65
+fi
+
+find -P "$artifact_dir" -type f -exec chmod 0444 {} +
+find -P "$artifact_dir" -depth -type d -exec chmod 0555 {} +

codex
One final compatibility detail surfaced from the Harness naming rules: captured results may be a direct `result/attempt-NNN.properties` file, not only a directory. I’m extending the protection helper to safely handle either a result file or an attempt directory, without creating or touching any attempt artifact now.
