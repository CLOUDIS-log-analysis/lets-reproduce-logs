+++ b/dist/SHA256SUMS
@@ -0,0 +1,2 @@
+aff33717de58fba95825ebea734572472d95470ca3c8e8e219da43de6db5cf25  zookeeper-3.4.4.tar.gz
+dd4765b45d9f1fc319a6e5be0bbc79371582daa8fd77872d51072f16deca2625  zulu6.22.0.3-ca-jdk6.0.119-linux_x64.tar.gz
diff --git a/scripts/docker-entrypoint.sh b/scripts/docker-entrypoint.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c9f5081d039bf084753b57a3242933d08f9a5589
--- /dev/null
+++ b/scripts/docker-entrypoint.sh
@@ -0,0 +1,21 @@
+#!/bin/sh
+set -eu
+
+# Files and directories created through host bind mounts must remain readable
+# and traversable by the host-side Harness account.
+umask 022
+
+for mounted_dir in /logs /data /result; do
+    if [ ! -d "$mounted_dir" ]; then
+        echo "required bind-mount directory is missing: $mounted_dir" >&2
+        exit 70
+    fi
+    if [ ! -r "$mounted_dir" ] || [ ! -w "$mounted_dir" ] || [ ! -x "$mounted_dir" ]; then
+        echo "required bind-mount directory is not readable, writable, and traversable: $mounted_dir" >&2
+        exit 71
+    fi
+done
+
+mkdir -p /data/txnlog /data/tmp
+
+exec "$@"
diff --git a/scripts/protect-artifacts.sh b/scripts/protect-artifacts.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c82edf8185bedefa712d438c8051d04b8fa6148a
--- /dev/null
+++ b/scripts/protect-artifacts.sh
@@ -0,0 +1,35 @@
+#!/bin/sh
+set -eu
+
+if [ "$#" -ne 1 ]; then
+    echo "usage: $0 logs/attempt-NNN-or-unique-name | result/attempt-NNN-or-unique-name" >&2
+    exit 64
+fi
+
+script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+issue_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
+
+if [ ! -d "$1" ]; then
+    echo "artifact directory does not exist: $1" >&2
+    exit 66
+fi
+
+artifact_dir=$(CDPATH= cd -- "$1" && pwd -P)
+case "$artifact_dir" in
+    "$issue_dir"/logs/*|"$issue_dir"/result/*) ;;
+    *)
+        echo "refusing to protect a path outside a per-attempt logs/ or result/ directory: $artifact_dir" >&2
+        exit 65
+        ;;
+esac
+
+# Reject symlinks so this helper can never change permissions outside the
+# selected artifact tree. Regular files become read-only and directories stay
+# readable/traversable, including for Harness processes outside the container.
+if find -P "$artifact_dir" -type l -print -quit | grep -q .; then
+    echo "refusing to protect an artifact tree containing symbolic links: $artifact_dir" >&2
+    exit 65
+fi
+
+find -P "$artifact_dir" -type f -exec chmod 0444 {} +
+find -P "$artifact_dir" -depth -type d -exec chmod 0555 {} +

diff --git a/Dockerfile b/Dockerfile
new file mode 100644
index 0000000000000000000000000000000000000000..26ec110c9ac587eace4c007fd659d307733b8514
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,37 @@
+FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
+
+ARG ZK_ARCHIVE=zookeeper-3.4.4.tar.gz
+ARG JDK_ARCHIVE=zulu6.22.0.3-ca-jdk6.0.119-linux_x64.tar.gz
+
+COPY dist/${ZK_ARCHIVE} dist/${JDK_ARCHIVE} dist/SHA256SUMS /tmp/dist/
+
+RUN set -eux; \
+    cd /tmp/dist; \
+    sha256sum -c SHA256SUMS; \
+    tar -xzf "${ZK_ARCHIVE}" -C /opt; \
+    tar -xzf "${JDK_ARCHIVE}" -C /opt; \
+    ln -s /opt/zookeeper-3.4.4 /opt/zookeeper; \
+    ln -s /opt/zulu6.22.0.3-jdk6.0.119-linux_x64 /opt/java; \
+    groupadd --gid 1000 zookeeper; \
+    useradd --uid 1000 --gid 1000 --home-dir /opt/zookeeper --shell /usr/sbin/nologin zookeeper; \
+    install -d -o zookeeper -g zookeeper -m 0755 /data /logs /result; \
+    rm -rf /tmp/dist
+
+COPY --chmod=0644 config/zoo.cfg config/log4j.properties /opt/zookeeper/conf/
+COPY --chmod=0755 scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
+
+ENV JAVA_HOME=/opt/java \
+    ZK_HOME=/opt/zookeeper \
+    ZOOCFGDIR=/opt/zookeeper/conf \
+    ZOO_LOG_DIR=/logs \
+    ZOO_LOG4J_PROP=INFO,CONSOLE,ROLLINGFILE \
+    JMXDISABLE=true \
+    SERVER_JVMFLAGS="-Xms128m -Xmx512m -Djava.io.tmpdir=/data/tmp" \
+    PATH=/opt/java/bin:/opt/zookeeper/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
+
+WORKDIR /opt/zookeeper
+USER 1000:1000
+EXPOSE 2181
+
+ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
+CMD ["/opt/zookeeper/bin/zkServer.sh", "start-foreground", "/opt/zookeeper/conf/zoo.cfg"]
