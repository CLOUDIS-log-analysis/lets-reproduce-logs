The fresh server is accepting connections on the isolated attempt port, with its live data already landing in the required snapshot/transaction categories. I’m launching the 500,000-byte synchronous create with the socket send-buffer injector enabled; if it remains blocked for 30 seconds, the process will be dumped before termination.
exec
/bin/bash -lc 'set -u
umask 022
java_bin=target/toolchain/zulu6.22.0.3-jdk6.0.119-linux_x64/bin/java
client_log=logs/zk1/app_logs/attempt-001/client-output.log
thread_dump=logs/zk1/jvm_logs/attempt-001/thread-dump.log
pid_file=logs/zk1/jvm_logs/attempt-001/client-pid.txt
status_file=logs/zk1/os_logs/attempt-001/client-execution.txt
"$java_bin" -Dzookeeper1560.sendBufferBytes=1024 '"\\
  -jar target/zookeeper-1560-reproduction-jar-with-dependencies.jar \\
  --connect 127.0.0.1:12182 --inject-small-send-buffer \\
  >\""'$client_log" 2>&1 &
client_pid=$!
printf '"'%s\\n' \""'$client_pid" | tee "$pid_file"
launch_ms=$(date +%s%3N)
started=0
start_marker_ms=0
while kill -0 "$client_pid" 2>/dev/null; do
  if grep -q '"'ZOOKEEPER_1560 large_create=started' \""'$client_log"; then
    started=1
    start_marker_ms=$(date +%s%3N)
    break
  fi
  now_ms=$(date +%s%3N)
  if [ $((now_ms - launch_ms)) -ge 20000 ]; then
    break
  fi
  sleep 0.1
done
timed_out=false
jstack_rc=not_run
if [ "$started" -eq 1 ]; then
  while kill -0 "$client_pid" 2>/dev/null; do
    now_ms=$(date +%s%3N)
    if [ $((now_ms - start_marker_ms)) -ge 30000 ]; then
      timed_out=true
      break
    fi
    sleep 0.1
  done
fi
if [ "$timed_out" = true ]; then
  "$java_bin" -version >/dev/null 2>&1
  target/toolchain/zulu6.22.0.3-jdk6.0.119-linux_x64/bin/jstack -l "$client_pid" >"$thread_dump" 2>&1
  jstack_rc=$?
  kill -TERM "$client_pid" 2>/dev/null || true
else
  printf '"'No deadline thread dump: client exited before the 30-second large-create deadline.\\n' >\""'$thread_dump"
fi
wait "$client_pid"
client_rc=$?
finish_ms=$(date +%s%3N)
{
  printf '"'client_pid=%s\\n' \""'$client_pid"
  printf '"'large_create_started=%s\\n' \""'$started"
  printf '"'timed_out=%s\\n' \""'$timed_out"
  printf '"'jstack_exit=%s\\n' \""'$jstack_rc"
  printf '"'client_exit=%s\\n' \""'$client_rc"
  printf '"'total_elapsed_ms=%s\\n' \""'$((finish_ms - launch_ms))"
